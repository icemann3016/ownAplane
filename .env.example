# Copy to .env.local and fill in. Never commit .env.local.
# Every setting is provider-neutral: moving to Google Cloud or Azure means changing values here,
# not code. See docs/deployment.md.

# ── Database: any PostgreSQL 14+ ────────────────────────────────────────────────
# Supabase: Connect → "Session pooler" URI (port 5432); put your DB password in place of [YOUR-PASSWORD]
#   (URL-encode special characters, e.g. @ → %40).
# Local Docker (docker compose up -d db): postgres://postgres:postgres@localhost:5432/ownaplane
DATABASE_URL=
# Optional: separate URL for migrations when DATABASE_URL is a transaction pooler (port 6543).
# On Vercel (Production) it also makes every production deploy apply migrations automatically.
# DATABASE_URL_MIGRATIONS=

# ── Login (Better Auth) ────────────────────────────────────────────────────────
# Random secret of 32+ characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this site, without trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# Require email confirmation before first login (only with EMAIL_DRIVER=smtp).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Extra allowed origins, comma-separated (e.g. preview URLs).
# BETTER_AUTH_TRUSTED_ORIGINS=
# Google sign-in (optional). Redirect URI in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple sign-in (optional, docs/deployment.md). Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple
# APPLE_CLIENT_ID=        # the Services ID, e.g. eu.ownaplane.signin
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=      # contents of the .p8 file (one line with \n is fine)
# Facebook sign-in (optional). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/facebook
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ── File storage ───────────────────────────────────────────────────────────────
# local = files on this computer (development only) | s3 = Supabase / Google Cloud Storage /
# AWS S3 / Cloudflare R2 | azure = Azure Blob Storage
STORAGE_DRIVER=local
# Public address where uploaded files can be viewed (no trailing slash). Needed for s3/azure.
#   Supabase: https://<project-ref>.supabase.co/storage/v1/object/public/media
#   Google:   https://storage.googleapis.com/<bucket>
#   Azure:    https://<account>.blob.core.windows.net/media
# STORAGE_PUBLIC_BASE_URL=

# s3 driver. Supabase: Storage → Settings → S3 Connection (endpoint, region, access keys).
#            Google Cloud Storage: Settings → Interoperability (HMAC keys), endpoint https://storage.googleapis.com
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1
# S3_BUCKET=media
# Private bucket for licence and medical scans (NOT public). Supabase: create a private bucket
# named "documents". Same keys and endpoint as above.
# S3_PRIVATE_BUCKET=documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# azure driver
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=media
# AZURE_STORAGE_PRIVATE_CONTAINER=documents

# ── Email ──────────────────────────────────────────────────────────────────────
# console = print emails in the terminal (development) | smtp = any SMTP service
EMAIL_DRIVER=console
# EMAIL_FROM="ownAplane <no-reply@your-domain.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ── Daily job (/api/cron/daily: expiry reminders, clean-up) ─────────────────────
# Random secret; the scheduler sends it as "Authorization: Bearer <secret>". Vercel Cron does this
# automatically when CRON_SECRET is set. Without it the job refuses to run.
# CRON_SECRET=

# Optional: map style for the search map (MapLibre). Default: OpenFreeMap (free, no key).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ── Monitoring (optional) ──────────────────────────────────────────────────────
# Error reports to any Sentry-compatible service (Sentry EU region, GlitchTip…): the project's
# DSN. Without it errors are only written to the server log.
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# Cookie-less page statistics. Plausible: SRC=https://plausible.io/js/script.js + DOMAIN;
# Umami: SRC=https://<your-umami>/script.js + WEBSITE_ID.
# NEXT_PUBLIC_ANALYTICS_SRC=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=ownaplane.eu
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Optional: weather API (METAR/TAF). Default: https://aviationweather.gov/api/data (free, no key).
# Browser tests point it at tests/e2e/fixtures/weather-mock.mjs.
# WEATHER_API_URL=
